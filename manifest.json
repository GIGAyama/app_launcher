{
  "manifest_version": 3,
  "name": "GIGA portal",
  "version": "2.0",
  "description": "よく使う学習ツールにすぐアクセスできるランチャーです。",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "GIGA portalを開く"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*", "*://*.google.co.jp/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js"],
      "matches": ["*://*.google.com/*", "*://*.google.co.jp/*"]
    }
  ]
}
